opam-version: "2.0"
synopsis: "Local multilingual ONNX embeddings and vector search for OCaml"
description: "OCaml library for multilingual E5 embeddings using ONNX Runtime and SentencePiece, with cosine retrieval and rank fusion."
maintainer: "Mathias Bourgoin"
authors: ["Mathias Bourgoin"]
license: "MIT"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.16"}
  "yojson"
  "uutf"
  "uunf"
  "caqti" {>= "2.3"}
  "caqti-driver-sqlite3"
  "eio"
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
